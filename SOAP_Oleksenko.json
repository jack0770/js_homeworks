    "name": "Book ISBN Numbers - SOAP API Tests",
    "description": "SOAP API testing collection for ISBN validation (ISBN10 and ISBN13)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "46301129",
