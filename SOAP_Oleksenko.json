  "item": [
    {
      "name": "IsValidISBN13 - Valid ISBN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Response Body Tests",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response body contains SOAP Envelope\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"soap:Envelope\");",
              "});",
              "",
              "pm.test(\"Response body contains IsValidISBN13Result\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"IsValidISBN13Result\");",
              "});",
              "",
              "pm.test(\"Response is valid XML format\", function () {",
              "    const responseBody = xml2Json(pm.response.text());",
              "    pm.expect(responseBody).to.not.be.undefined;",
              "});",
              "",
              "pm.test(\"ISBN13 validation result is boolean\", function () {",
              "    const responseBody = pm.response.text();",
              "    const hasTrueOrFalse = responseBody.includes(\">true<\") || responseBody.includes(\">false<\");",
              "    pm.expect(hasTrueOrFalse).to.be.true;",
              "});",
              "",
              "",
              "pm.test(\"Response contains SOAP Body\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"soap:Body\");",
              "});",
              "",
              "pm.test(\"Response time is less than 3000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "// Header Tests",
              "pm.test(\"Content-Type header is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});",
              "",
              "pm.test(\"Content-Type is text/xml\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
              "});",
              "",
              "pm.test(\"Response size is greater than 0\", function () {",
              "    pm.expect(pm.response.size().body).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8",
            "type": "text"
          },
          {
            "key": "SOAPAction",
            "value": "http://webservices.daehosting.com/ISBN/IsValidISBN13",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>",
